{
  "name": "InstructorReview",
  "type": "object",
  "properties": {
    "instructor_id": {
      "type": "string",
      "description": "ID do instrutor"
    },
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "rating": {
      "type": "number",
      "description": "Nota de 1 a 5"
    },
    "comment": {
      "type": "string",
      "description": "Coment\u00e1rio sobre o instrutor"
    }
  },
  "required": [
    "instructor_id",
    "rating"
  ]
}