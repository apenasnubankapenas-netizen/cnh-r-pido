{
  "name": "InstructorAccessCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo de acesso \u00fanico para registro de instrutor"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Se o c\u00f3digo foi utilizado"
    },
    "used_by_email": {
      "type": "string",
      "description": "Email de quem usou o c\u00f3digo"
    },
    "used_at": {
      "type": "string",
      "description": "Data/hora ISO quando foi usado"
    },
    "expires_at": {
      "type": "string",
      "description": "Data/hora ISO de expira\u00e7\u00e3o do c\u00f3digo"
    },
    "notes": {
      "type": "string",
      "description": "Notas do super admin"
    }
  },
  "required": [
    "code"
  ]
}