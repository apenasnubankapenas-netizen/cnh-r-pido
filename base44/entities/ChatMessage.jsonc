{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID da conversa"
    },
    "sender_email": {
      "type": "string",
      "description": "Email do remetente"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "student",
        "seller",
        "admin"
      ],
      "description": "Papel do remetente"
    },
    "message": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "read": {
      "type": "boolean",
      "description": "Mensagem lida"
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "message"
  ]
}