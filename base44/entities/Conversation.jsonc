{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "seller_email": {
      "type": "string",
      "description": "Email do vendedor atribu\u00eddo"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "last_message": {
      "type": "string",
      "description": "\u00daltima mensagem"
    },
    "unread_count": {
      "type": "number",
      "description": "Mensagens n\u00e3o lidas"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "fechada"
      ],
      "description": "Status da conversa"
    }
  },
  "required": [
    "student_id",
    "student_email"
  ]
}