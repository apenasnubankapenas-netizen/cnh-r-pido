  "name": "InstructorInvite",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Token do convite"
    },
    "used": {
      "type": "boolean",
      "description": "Convite j\u00e1 utilizado",
      "default": false
    },
